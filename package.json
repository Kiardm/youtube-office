{
  "name": "youtube-office",
  "displayName": "YouTube Office 4.1",
  "description": "Portable multi-provider YouTube production office with private local memory and encrypted co-op",
  "version": "4.1.1",
  "private": true,
  "icon": "icon.png",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "office": "electron electron/main.cjs",
    "office:bridge": "node youtube-office/bridge-service.js",
    "office:status": "node youtube-office/office-cli.js status",
    "office:test": "node --test youtube-office/*.test.js packages/relay/*.test.js",
    "office:test-visual": "node scripts/verify-office-visuals.cjs",
    "office:audit-distribution": "node scripts/audit-distribution.cjs",
    "build:webview": "cd webview-ui && pnpm build",
    "build": "pnpm build:webview",
    "compile": "pnpm check-types && pnpm lint && pnpm build:webview",
    "watch": "cd webview-ui && pnpm dev",
    "check-types": "cd webview-ui && pnpm exec tsc --noEmit",
    "lint": "cd webview-ui && pnpm lint",
    "import-tileset": "tsx scripts/0-import-tileset.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@types/node": "22.x",
    "@types/pngjs": "^6.0.5",
    "electron": "^38.2.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "gifenc": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "wrangler": "4.134.0"
  },
  "dependencies": {
    "ws": "^8.19.0"
  }
}
